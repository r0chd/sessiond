{"schema":3,"source_digest":"2569ec176cb5441eea62c463a043a614ef4f418d747aa2426d8621ee3308ca4c","dependencies":[],"processor_digest":"aa2c0b70a2a797a4a73344f12de87c6e05b632270d9ec92b9b4697f5d15c4cfb","result":{"html":"<html><head></head><body><h1 id=\"nixos\">NixOS</h1>\n<p><code>sessiond</code> is not officially supported on NixOS and requires additional manual\nconfiguration. NixOS is deeply integrated with <code>logind</code>, which <code>sessiond</code>\nreplaces, so some system components may continue to depend on <code>logind</code> and need\nseparate adjustment.</p>\n<h2 id=\"install-the-module\">Install the module</h2>\n<p>Choose your prefered way of pinning the source.</p>\n<h3 id=\"flakes\">Flakes</h3>\n<p>Add the input to your flake and import its module in your NixOS configuration:</p>\n<html><head></head><body><pre class=\"highlight\"><code class=\"language-nix\"><span style=\"color:rgb(132,139,152);\">{</span><br>&nbsp;&nbsp;<span style=\"color:rgb(86,182,194);\">inputs</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">sessiond</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">url</span>&nbsp;<span style=\"color:rgb(171,178,191);\">=</span>&nbsp;<span style=\"color:rgb(152,195,121);\">\"</span><span style=\"color:rgb(152,195,121);\">git+https://tangled.org/r0chd.pl/sessiond</span><span style=\"color:rgb(152,195,121);\">\"</span><span style=\"color:rgb(132,139,152);\">;</span><br><br>&nbsp;&nbsp;<span style=\"color:rgb(97,175,239);\">outputs</span>&nbsp;<span style=\"color:rgb(171,178,191);\">=</span>&nbsp;<span style=\"color:rgb(132,139,152);\">{</span>&nbsp;<span style=\"color:rgb(232,102,113);\">self</span><span style=\"color:rgb(132,139,152);\">,</span>&nbsp;<span style=\"color:rgb(232,102,113);\">nixpkgs</span><span style=\"color:rgb(132,139,152);\">,</span>&nbsp;<span style=\"color:rgb(232,102,113);\">sessiond</span><span style=\"color:rgb(132,139,152);\">,</span>&nbsp;<span style=\"color:rgb(232,102,113);\">...</span>&nbsp;<span style=\"color:rgb(132,139,152);\">}</span><span style=\"color:rgb(132,139,152);\">:</span>&nbsp;<span style=\"color:rgb(132,139,152);\">{</span><br>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"color:rgb(86,182,194);\">nixosConfigurations</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">myHost</span>&nbsp;<span style=\"color:rgb(171,178,191);\">=</span>&nbsp;<span style=\"color:rgb(171,178,191);\">nixpkgs</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">lib</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(97,175,239);\">nixosSystem</span>&nbsp;<span style=\"color:rgb(132,139,152);\">{</span><br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"color:rgb(86,182,194);\">modules</span>&nbsp;<span style=\"color:rgb(171,178,191);\">=</span>&nbsp;<span style=\"color:rgb(132,139,152);\">[</span><br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"color:rgb(232,102,113);\">./configuration.nix</span><br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"color:rgb(171,178,191);\">sessiond</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">nixosModules</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">default</span><br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"color:rgb(132,139,152);\">{</span>&nbsp;<span style=\"color:rgb(86,182,194);\">services</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">sessiond</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">enable</span>&nbsp;<span style=\"color:rgb(171,178,191);\">=</span>&nbsp;<span style=\"color:rgb(209,154,102);\">true</span><span style=\"color:rgb(132,139,152);\">;</span>&nbsp;<span style=\"color:rgb(132,139,152);\">}</span><br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"color:rgb(132,139,152);\">]</span><span style=\"color:rgb(132,139,152);\">;</span><br>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"color:rgb(132,139,152);\">}</span><span style=\"color:rgb(132,139,152);\">;</span><br>&nbsp;&nbsp;<span style=\"color:rgb(132,139,152);\">}</span><span style=\"color:rgb(132,139,152);\">;</span><br><span style=\"color:rgb(132,139,152);\">}</span><br></code></pre></body></html>\n<h3 id=\"npins\">npins</h3>\n<html><head></head><body><pre class=\"highlight\"><code class=\"language-bash\"><span style=\"color:rgb(97,175,239);\">npins</span>&nbsp;<span style=\"color:rgb(232,102,113);\">add</span>&nbsp;<span style=\"color:rgb(232,102,113);\">git</span>&nbsp;<span style=\"color:rgb(232,102,113);\">--name</span>&nbsp;<span style=\"color:rgb(232,102,113);\">sessiond</span>&nbsp;<span style=\"color:rgb(232,102,113);\">https://tangled.org/r0chd.pl/sessiond</span>&nbsp;<span style=\"color:rgb(232,102,113);\">--branch</span>&nbsp;<span style=\"color:rgb(232,102,113);\">master</span><br></code></pre></body></html>\n<html><head></head><body><pre class=\"highlight\"><code class=\"language-nix\"><span style=\"color:rgb(198,120,221);\">let</span><br>&nbsp;&nbsp;sources&nbsp;<span style=\"color:rgb(171,178,191);\">=</span>&nbsp;<span style=\"color:rgb(198,120,221);\">import</span>&nbsp;<span style=\"color:rgb(232,102,113);\">./npins</span><span style=\"color:rgb(132,139,152);\">;</span><br>&nbsp;&nbsp;sessiond&nbsp;<span style=\"color:rgb(171,178,191);\">=</span>&nbsp;<span style=\"color:rgb(198,120,221);\">import</span>&nbsp;<span style=\"color:rgb(171,178,191);\">sources</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">sessiond</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">outPath</span>&nbsp;<span style=\"color:rgb(132,139,152);\">{</span>&nbsp;<span style=\"color:rgb(132,139,152);\">}</span><span style=\"color:rgb(132,139,152);\">;</span><br><span style=\"color:rgb(198,120,221);\">in</span><br><span style=\"color:rgb(132,139,152);\">{</span><br>&nbsp;&nbsp;<span style=\"color:rgb(86,182,194);\">imports</span>&nbsp;<span style=\"color:rgb(171,178,191);\">=</span>&nbsp;<span style=\"color:rgb(132,139,152);\">[</span>&nbsp;<span style=\"color:rgb(171,178,191);\">sessiond</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">nixosModules</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">default</span>&nbsp;<span style=\"color:rgb(132,139,152);\">]</span><span style=\"color:rgb(132,139,152);\">;</span><br>&nbsp;&nbsp;<span style=\"color:rgb(86,182,194);\">services</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">sessiond</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">enable</span>&nbsp;<span style=\"color:rgb(171,178,191);\">=</span>&nbsp;<span style=\"color:rgb(209,154,102);\">true</span><span style=\"color:rgb(132,139,152);\">;</span><br><span style=\"color:rgb(132,139,152);\">}</span><br></code></pre></body></html>\n<h2 id=\"using-sessiond-in-place-of-logind\">Using sessiond in place of logind</h2>\n<p>Enabling the module does not disable <code>logind</code>. Running both services causes\nconflicts, each attempts to move the session leader process, such as a greeter,\ninto its own cgroup. Moving the process out of the other service's cgroup\ndisrupts its session tracking. Disable <code>logind</code> when using <code>sessiond</code>.</p>\n<html><head></head><body><pre class=\"highlight\"><code class=\"language-nix\"><span style=\"color:rgb(132,139,152);\">{</span>&nbsp;<span style=\"color:rgb(232,102,113);\">pkgs</span><span style=\"color:rgb(132,139,152);\">,</span>&nbsp;<span style=\"color:rgb(232,102,113);\">...</span>&nbsp;<span style=\"color:rgb(132,139,152);\">}</span><span style=\"color:rgb(132,139,152);\">:</span><br><span style=\"color:rgb(132,139,152);\">{</span><br>&nbsp;&nbsp;<span style=\"color:rgb(86,182,194);\">services</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">logind</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">enable</span>&nbsp;<span style=\"color:rgb(171,178,191);\">=</span>&nbsp;<span style=\"color:rgb(209,154,102);\">false</span><span style=\"color:rgb(132,139,152);\">;</span><br><span style=\"color:rgb(132,139,152);\">}</span><br></code></pre></body></html>\n<p>This keeps <code>systemd</code> as the system service manager but removes ability for <code>systemd</code>\nto manage user services. You also lose ability to view <code>systemd</code> service status without\nroot permissions</p>\n<h2 id=\"pam-integration\">PAM integration</h2>\n<p>The module starts the daemon but does not add the PAM session rule. To register\nconsole logins, configure the <code>login</code> PAM service:</p>\n<html><head></head><body><pre class=\"highlight\"><code class=\"language-nix\"><span style=\"color:rgb(132,139,152);\">{</span>&nbsp;<span style=\"color:rgb(232,102,113);\">config</span><span style=\"color:rgb(132,139,152);\">,</span>&nbsp;<span style=\"color:rgb(232,102,113);\">...</span>&nbsp;<span style=\"color:rgb(132,139,152);\">}</span><span style=\"color:rgb(132,139,152);\">:</span>&nbsp;<span style=\"color:rgb(132,139,152);\">{</span><br>&nbsp;&nbsp;<span style=\"color:rgb(86,182,194);\">security</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">pam</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">services</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">login</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">rules</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">session</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">sessiond</span>&nbsp;<span style=\"color:rgb(171,178,191);\">=</span>&nbsp;<span style=\"color:rgb(132,139,152);\">{</span><br>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"color:rgb(86,182,194);\">control</span>&nbsp;<span style=\"color:rgb(171,178,191);\">=</span>&nbsp;<span style=\"color:rgb(152,195,121);\">\"</span><span style=\"color:rgb(152,195,121);\">optional</span><span style=\"color:rgb(152,195,121);\">\"</span><span style=\"color:rgb(132,139,152);\">;</span><br>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"color:rgb(86,182,194);\">modulePath</span>&nbsp;<span style=\"color:rgb(171,178,191);\">=</span>&nbsp;<span style=\"color:rgb(152,195,121);\">\"</span><span style=\"color:rgb(232,102,113);\">${</span><span style=\"color:rgb(171,178,191);\">config</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">services</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">sessiond</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">package</span><span style=\"color:rgb(232,102,113);\">}</span><span style=\"color:rgb(152,195,121);\">/lib/security/pam_sessiond.so</span><span style=\"color:rgb(152,195,121);\">\"</span><span style=\"color:rgb(132,139,152);\">;</span><br>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"color:rgb(86,182,194);\">order</span>&nbsp;<span style=\"color:rgb(171,178,191);\">=</span>&nbsp;<span style=\"color:rgb(209,154,102);\">900</span><span style=\"color:rgb(132,139,152);\">;</span><br>&nbsp;&nbsp;<span style=\"color:rgb(132,139,152);\">}</span><span style=\"color:rgb(132,139,152);\">;</span><br><span style=\"color:rgb(132,139,152);\">}</span><br></code></pre></body></html>\n<p>For other login paths, add the rule to the corresponding PAM service as well.\nConfiguring <code>login</code> alone does not configure a display manager or SSH.</p>\n<h2 id=\"seat-management\">Seat management</h2>\n<p><code>sessiond</code> does not provide seat management on its own. To allow your compositor\nto access graphical devices, enable <code>seatd</code> and add your user to the <code>seat</code> group.</p>\n<html><head></head><body><pre class=\"highlight\"><code class=\"language-nix\"><span style=\"color:rgb(132,139,152);\">{</span>&nbsp;<span style=\"color:rgb(232,102,113);\">config</span><span style=\"color:rgb(132,139,152);\">,</span>&nbsp;<span style=\"color:rgb(232,102,113);\">...</span>&nbsp;<span style=\"color:rgb(132,139,152);\">}</span><span style=\"color:rgb(132,139,152);\">:</span>&nbsp;<span style=\"color:rgb(132,139,152);\">{</span><br>&nbsp;&nbsp;<span style=\"color:rgb(86,182,194);\">services</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">seatd</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">enable</span>&nbsp;<span style=\"color:rgb(171,178,191);\">=</span>&nbsp;<span style=\"color:rgb(209,154,102);\">true</span><span style=\"color:rgb(132,139,152);\">;</span><br><br>&nbsp;&nbsp;<span style=\"color:rgb(86,182,194);\">users</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">users</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">myUser</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">extraGroups</span>&nbsp;<span style=\"color:rgb(171,178,191);\">=</span>&nbsp;<span style=\"color:rgb(132,139,152);\">[</span>&nbsp;<span style=\"color:rgb(171,178,191);\">config</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">services</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">seatd</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">group</span>&nbsp;<span style=\"color:rgb(132,139,152);\">]</span><span style=\"color:rgb(132,139,152);\">;</span><br><span style=\"color:rgb(132,139,152);\">}</span><br></code></pre></body></html>\n<h2 id=\"greeters-display-managers\">Greeters/Display Managers</h2>\n<p>To allow the greeter to access graphical devices, add the user under which the\nservice runs to the <code>seat</code> group. Also ensure that <code>greetd</code> starts after both\n<code>seatd</code> and <code>sessiond</code> to avoid race conditions.</p>\n<html><head></head><body><pre class=\"highlight\"><code class=\"language-nix\"><span style=\"color:rgb(132,139,152);\">{</span>&nbsp;<span style=\"color:rgb(232,102,113);\">config</span><span style=\"color:rgb(132,139,152);\">,</span>&nbsp;<span style=\"color:rgb(232,102,113);\">...</span>&nbsp;<span style=\"color:rgb(132,139,152);\">}</span><span style=\"color:rgb(132,139,152);\">:</span>&nbsp;<span style=\"color:rgb(132,139,152);\">{</span><br>&nbsp;&nbsp;<span style=\"color:rgb(86,182,194);\">users</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">users</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">cosmic-greeter</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">extraGroups</span>&nbsp;<span style=\"color:rgb(171,178,191);\">=</span>&nbsp;&nbsp;<span style=\"color:rgb(132,139,152);\">[</span><br>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"color:rgb(171,178,191);\">config</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">services</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">seatd</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">group</span><br>&nbsp;&nbsp;<span style=\"color:rgb(132,139,152);\">]</span><span style=\"color:rgb(132,139,152);\">;</span><br>&nbsp;&nbsp;<br>&nbsp;&nbsp;<span style=\"color:rgb(86,182,194);\">systemd</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">services</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">greetd</span>&nbsp;<span style=\"color:rgb(171,178,191);\">=</span>&nbsp;<span style=\"color:rgb(132,139,152);\">{</span><br>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"color:rgb(86,182,194);\">wants</span>&nbsp;<span style=\"color:rgb(171,178,191);\">=</span>&nbsp;<span style=\"color:rgb(132,139,152);\">[</span>&nbsp;<span style=\"color:rgb(152,195,121);\">\"</span><span style=\"color:rgb(152,195,121);\">seatd.service</span><span style=\"color:rgb(152,195,121);\">\"</span>&nbsp;<span style=\"color:rgb(152,195,121);\">\"</span><span style=\"color:rgb(152,195,121);\">sessiond.service</span><span style=\"color:rgb(152,195,121);\">\"</span>&nbsp;<span style=\"color:rgb(132,139,152);\">]</span><span style=\"color:rgb(132,139,152);\">;</span><br>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"color:rgb(86,182,194);\">after</span>&nbsp;<span style=\"color:rgb(171,178,191);\">=</span>&nbsp;<span style=\"color:rgb(132,139,152);\">[</span>&nbsp;<span style=\"color:rgb(152,195,121);\">\"</span><span style=\"color:rgb(152,195,121);\">seatd.service</span><span style=\"color:rgb(152,195,121);\">\"</span>&nbsp;<span style=\"color:rgb(152,195,121);\">\"</span><span style=\"color:rgb(152,195,121);\">sessiond.service</span><span style=\"color:rgb(152,195,121);\">\"</span>&nbsp;<span style=\"color:rgb(132,139,152);\">]</span><span style=\"color:rgb(132,139,152);\">;</span><br>&nbsp;&nbsp;<span style=\"color:rgb(132,139,152);\">}</span><span style=\"color:rgb(132,139,152);\">;</span><br><span style=\"color:rgb(132,139,152);\">}</span><br></code></pre></body></html>\n<h3 id=\"switch-to-configuration\">switch-to-configuration</h3>\n<p>With <code>sessiond</code>, you have two options when applying a NixOS configuration:</p>\n<ul>\n<li>\n<p>Use <code>nixos-rebuild boot</code> and reboot.</p>\n</li>\n<li>\n<p>Use <a href=\"https://tangled.org/r0chd.pl/switch-to-configuration-ng\">my fork of <code>switch-to-configuration-ng</code></a> to switch without rebooting.</p>\n<html><head></head><body><pre class=\"highlight\"><code class=\"language-nix\"><span style=\"color:rgb(92,99,112);font-style: italic;\">#&nbsp;In&nbsp;your&nbsp;flake's&nbsp;inputs:</span><br><span style=\"color:rgb(171,178,191);\">inputs</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">switch-to-configuration</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(97,175,239);\">url</span>&nbsp;<span style=\"color:rgb(171,178,191);\">=</span><br>&nbsp;&nbsp;<span style=\"color:rgb(152,195,121);\">\"</span><span style=\"color:rgb(152,195,121);\">git+https://tangled.org/r0chd.pl/switch-to-configuration-ng</span><span style=\"color:rgb(152,195,121);\">\"</span><span style=\"color:rgb(132,139,152);\">;</span><br><br><span style=\"color:rgb(92,99,112);font-style: italic;\">#&nbsp;In&nbsp;a&nbsp;NixOS&nbsp;module:</span><br><span style=\"color:rgb(132,139,152);\">{</span>&nbsp;inputs<span style=\"color:rgb(132,139,152);\">,</span>&nbsp;<span style=\"color:rgb(232,102,113);\">...</span>&nbsp;<span style=\"color:rgb(132,139,152);\">}</span><span style=\"color:rgb(132,139,152);\">:</span>&nbsp;<span style=\"color:rgb(132,139,152);\">{</span><br>&nbsp;&nbsp;<span style=\"color:rgb(86,182,194);\">nixpkgs</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">overlays</span>&nbsp;<span style=\"color:rgb(171,178,191);\">=</span>&nbsp;<span style=\"color:rgb(132,139,152);\">[</span><br>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"color:rgb(132,139,152);\">(</span><span style=\"color:rgb(232,102,113);\">final</span><span style=\"color:rgb(232,102,113);\">:</span>&nbsp;<span style=\"color:rgb(232,102,113);\">prev</span><span style=\"color:rgb(232,102,113);\">:</span>&nbsp;<span style=\"color:rgb(132,139,152);\">{</span><br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"color:rgb(86,182,194);\">switch-to-configuration-ng</span>&nbsp;<span style=\"color:rgb(171,178,191);\">=</span>&nbsp;<span style=\"color:rgb(171,178,191);\">inputs</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">switch-to-configuration</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">packages</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">default</span><span style=\"color:rgb(132,139,152);\">;</span><br>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"color:rgb(132,139,152);\">}</span><span style=\"color:rgb(132,139,152);\">)</span><br>&nbsp;&nbsp;<span style=\"color:rgb(132,139,152);\">]</span><span style=\"color:rgb(132,139,152);\">;</span><br><span style=\"color:rgb(132,139,152);\">}</span><br></code></pre></body></html>\n</li>\n</ul>\n<p>To use <code>switch-to-configuration-ng</code>, the user systemd service manager needs to\nbe running. The recommended way is to use <code>sessiond-hooks</code> to start and\nsupervise it:</p>\n<html><head></head><body><pre class=\"highlight\"><code class=\"language-nix\"><span style=\"color:rgb(132,139,152);\">{</span>&nbsp;<span style=\"color:rgb(232,102,113);\">inputs</span><span style=\"color:rgb(132,139,152);\">,</span>&nbsp;<span style=\"color:rgb(232,102,113);\">pkgs</span><span style=\"color:rgb(132,139,152);\">,</span>&nbsp;<span style=\"color:rgb(232,102,113);\">...</span>&nbsp;<span style=\"color:rgb(132,139,152);\">}</span><span style=\"color:rgb(132,139,152);\">:</span>&nbsp;<span style=\"color:rgb(132,139,152);\">{</span><br>&nbsp;&nbsp;<span style=\"color:rgb(86,182,194);\">imports</span>&nbsp;<span style=\"color:rgb(171,178,191);\">=</span>&nbsp;<span style=\"color:rgb(132,139,152);\">[</span>&nbsp;<span style=\"color:rgb(171,178,191);\">inputs</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">sessiond</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">nixosModules</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">sessiond-hooks</span>&nbsp;<span style=\"color:rgb(132,139,152);\">]</span><span style=\"color:rgb(132,139,152);\">;</span><br><br>&nbsp;&nbsp;<span style=\"color:rgb(86,182,194);\">services</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">sessiond-hooks</span>&nbsp;<span style=\"color:rgb(171,178,191);\">=</span>&nbsp;<span style=\"color:rgb(132,139,152);\">{</span><br>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"color:rgb(86,182,194);\">package</span>&nbsp;<span style=\"color:rgb(171,178,191);\">=</span>&nbsp;<span style=\"color:rgb(171,178,191);\">inputs</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">sessiond</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">packages</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">sessiond-hooks</span><span style=\"color:rgb(132,139,152);\">;</span><br>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"color:rgb(86,182,194);\">debug</span>&nbsp;<span style=\"color:rgb(171,178,191);\">=</span>&nbsp;<span style=\"color:rgb(209,154,102);\">true</span><span style=\"color:rgb(132,139,152);\">;</span><br>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"color:rgb(86,182,194);\">hooks</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">systemd</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">settings</span>&nbsp;<span style=\"color:rgb(171,178,191);\">=</span>&nbsp;<span style=\"color:rgb(132,139,152);\">{</span><br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"color:rgb(86,182,194);\">on_start</span>&nbsp;<span style=\"color:rgb(171,178,191);\">=</span>&nbsp;<span style=\"color:rgb(152,195,121);\">\"</span><span style=\"color:rgb(232,102,113);\">${</span><span style=\"color:rgb(171,178,191);\">pkgs</span><span style=\"color:rgb(132,139,152);\">.</span><span style=\"color:rgb(86,182,194);\">systemd</span><span style=\"color:rgb(232,102,113);\">}</span><span style=\"color:rgb(152,195,121);\">/lib/systemd/systemd</span><span style=\"color:rgb(152,195,121);\">\"</span><span style=\"color:rgb(132,139,152);\">;</span><br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"color:rgb(86,182,194);\">restart</span>&nbsp;<span style=\"color:rgb(171,178,191);\">=</span>&nbsp;<span style=\"color:rgb(132,139,152);\">{</span><br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"color:rgb(86,182,194);\">on</span>&nbsp;<span style=\"color:rgb(171,178,191);\">=</span>&nbsp;<span style=\"color:rgb(152,195,121);\">\"</span><span style=\"color:rgb(152,195,121);\">Always</span><span style=\"color:rgb(152,195,121);\">\"</span><span style=\"color:rgb(132,139,152);\">;</span><br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"color:rgb(86,182,194);\">delay</span>&nbsp;<span style=\"color:rgb(171,178,191);\">=</span>&nbsp;<span style=\"color:rgb(209,154,102);\">5</span><span style=\"color:rgb(132,139,152);\">;</span><br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"color:rgb(132,139,152);\">}</span><span style=\"color:rgb(132,139,152);\">;</span><br>&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"color:rgb(132,139,152);\">}</span><span style=\"color:rgb(132,139,152);\">;</span><br>&nbsp;&nbsp;<span style=\"color:rgb(132,139,152);\">}</span><span style=\"color:rgb(132,139,152);\">;</span><br><span style=\"color:rgb(132,139,152);\">}</span><br></code></pre></body></html>\n</body></html>","headers":[{"text":"NixOS","level":1,"id":"nixos"},{"text":"Install the module","level":2,"id":"install-the-module"},{"text":"Flakes","level":3,"id":"flakes"},{"text":"npins","level":3,"id":"npins"},{"text":"Using sessiond in place of logind","level":2,"id":"using-sessiond-in-place-of-logind"},{"text":"PAM integration","level":2,"id":"pam-integration"},{"text":"Seat management","level":2,"id":"seat-management"},{"text":"Greeters/Display Managers","level":2,"id":"greeters-display-managers"},{"text":"switch-to-configuration","level":3,"id":"switch-to-configuration"}],"title":"NixOS","included_files":[]},"frontmatter":null}