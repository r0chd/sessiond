 <object name="seat_core_manager" version="1">
  <description summary="seat observer">
   Unprivileged read-only interface for observing seats and their clients.
  </description>
  <s2c name="seat_added">
   <description summary="a seat is available">
    Sent once for each configured seat when the manager is created and when a
    seat is added.
   </description>
   <arg name="seat" type="varchar" summary="seat name"/>
  </s2c>
  <s2c name="done"><description summary="initial seat list complete"/></s2c>
  <s2c name="error">
   <arg name="code" type="enum" interface="error_code" summary="error kind"/>
   <arg name="message" type="varchar" summary="human-readable error detail"/>
  </s2c>
  <c2s name="get_seat">
   <description summary="create a per-seat info object">
    Creates a seat_core_seat object for the named seat. The daemon immediately
    pushes all fields, followed by done.
   </description>
   <arg name="seat" type="varchar" summary="seat name"/>
   <returns iface="seat_core_seat"/>
  </c2s>
  <c2s name="destroy" destructor="true"></c2s>
 </object>

 <object name="seat_core_seat" version="1">
  <description summary="per-seat information">
   Provides information about a single configured seat. Fields are pushed on
   creation and re-sent when they change.
  </description>
  <s2c name="seat"><description summary="seat name"/><arg name="seat" type="varchar" summary="seat name"/></s2c>
  <s2c name="mode"><description summary="seat mode"/><arg name="mode" type="enum" interface="seat_mode" summary="seat mode"/></s2c>
  <s2c name="current_vt"><description summary="current virtual terminal"/><arg name="vt" type="uint" summary="current virtual terminal, or zero"/></s2c>
  <s2c name="client_added"><description summary="seat client added"/><arg name="pid" type="uint" summary="client PID"/></s2c>
  <s2c name="client_removed"><description summary="seat client removed"/><arg name="pid" type="uint" summary="client PID"/></s2c>
  <c2s name="get_client">
   <arg name="pid" type="uint" summary="client PID"/>
   <returns iface="seat_core_client"/>
  </c2s>
  <s2c name="done"><description summary="initial seat dump complete"/></s2c>
  <s2c name="destroyed"><description summary="seat has been removed or did not exist"/></s2c>
  <s2c name="error">
   <arg name="code" type="enum" interface="error_code" summary="error kind"/>
   <arg name="message" type="varchar" summary="human-readable error detail"/>
  </s2c>
  <c2s name="destroy" destructor="true"></c2s>
 </object>

 <object name="seat_core_client" version="1">
  <description summary="per-seat-client information">
   Provides information about a client attached to a seat.
  </description>
  <s2c name="session"><description summary="session identifier"/><arg name="session" type="uint" summary="session identifier"/></s2c>
  <s2c name="state"><description summary="client state"/><arg name="state" type="enum" interface="client_state" summary="client state"/></s2c>
  <s2c name="active"><description summary="active state"/><arg name="active" type="uint" summary="non-zero if active"/></s2c>
  <s2c name="next"><description summary="queued state"/><arg name="next" type="uint" summary="non-zero if queued next"/></s2c>
  <s2c name="pid"><description summary="client PID"/><arg name="pid" type="uint" summary="client PID"/></s2c>
  <s2c name="uid"><description summary="client UID"/><arg name="uid" type="uint" summary="client UID"/></s2c>
  <s2c name="gid"><description summary="client GID"/><arg name="gid" type="uint" summary="client GID"/></s2c>
  <s2c name="device_added"><description summary="seat device added"/><arg name="device_id" type="uint" summary="device identifier"/></s2c>
  <s2c name="device_removed"><description summary="seat device removed"/><arg name="device_id" type="uint" summary="device identifier"/></s2c>
  <c2s name="get_device">
   <description summary="create a per-device info object"/>
   <arg name="device_id" type="uint" summary="device identifier"/>
   <returns iface="seat_core_device"/>
  </c2s>
  <s2c name="done"><description summary="initial client dump complete"/></s2c>
  <s2c name="destroyed"><description summary="client has been removed or did not exist"/></s2c>
  <c2s name="destroy" destructor="true"></c2s>
 </object>

 <object name="seat_core_device" version="1">
  <description summary="per-seat-device information">
   Provides information about a device assigned to a seat client.
  </description>
  <s2c name="device_id"><description summary="device identifier"/><arg name="device_id" type="uint" summary="device identifier"/></s2c>
  <s2c name="path"><description summary="device path"/><arg name="path" type="varchar" summary="device path"/></s2c>
  <s2c name="kind"><description summary="device kind"/><arg name="kind" type="enum" interface="device_kind" summary="device kind"/></s2c>
  <s2c name="active"><description summary="device active state"/><arg name="active" type="uint" summary="non-zero if active"/></s2c>
  <s2c name="done"><description summary="initial device dump complete"/></s2c>
  <s2c name="destroyed"><description summary="device has been removed or did not exist"/></s2c>
  <c2s name="destroy" destructor="true"></c2s>
 </object>

 <enum name="seat_mode">
  <value idx="0" name="vt_bound" summary="seat follows the active virtual terminal"/>
  <value idx="1" name="non_vt_bound" summary="seat is not VT-bound"/>
 </enum>
 <enum name="client_state">
  <value idx="0" name="new" summary="client is not yet enabled"/>
  <value idx="1" name="enabled" summary="client may use seat devices"/>
  <value idx="2" name="pending_disabled" summary="client must acknowledge disabled state"/>
  <value idx="3" name="disabled" summary="client is inactive"/>
  <value idx="4" name="closed" summary="client is closing"/>
 </enum>
 <enum name="device_kind">
  <value idx="0" name="drm" summary="DRM device"/>
  <value idx="1" name="evdev" summary="evdev input device"/>
  <value idx="2" name="hidraw" summary="hidraw device"/>
  <value idx="3" name="wscons" summary="wscons device"/>
  <value idx="4" name="unknown" summary="unknown device"/>
 </enum>
 <enum name="error_code">
  <value idx="0" name="not_found" summary="seat or client not found"/>
  <value idx="1" name="permission_denied" summary="operation not permitted"/>
  <value idx="2" name="io" summary="generic I/O error"/>
 </enum>
</protocol>
